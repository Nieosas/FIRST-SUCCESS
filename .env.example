# ---------------------------------------------------------------------------
# Supabase (Database + Auth). Find these in Supabase Dashboard:
#   Project Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Project Settings -> API -> service_role (server only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Mailgun (order confirmation emails). Domain & API key in Mailgun dashboard.
# ---------------------------------------------------------------------------
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=YOUR_DOMAIN.mailgun.org
MAILGUN_FROM=PhoneDeck <orders@YOUR_DOMAIN.mailgun.org>

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
